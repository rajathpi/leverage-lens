{
  "manifest_version": 3,
  "name": "Leverage Lens",
  "version": "0.1.0",
  "description": "Adds a small card to Avanza product pages: live leverage, distance to the stop, today's move and the AVA products on a stock.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://www.avanza.se/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/*"], "matches": ["https://www.avanza.se/*"] }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
